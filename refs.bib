  author = {Reimann, Lennart M. and Prashar, Anshul and Ghinami, Chiara and Pelke, Rebecca and Sisejkovic, Dominik and Merchant, Farhad and Leupers, Rainer},
  urldate = {2025-05-21},
  date = {2024-04},
  keywords = {Benchmark testing, confidentiality, hardware security, Information leakage, Measurement, Open source hardware, quantitative information flow, Sequential circuits, status:read, Timing, timing channels, Very large scale integration},
  file = {Full Text PDF:/home/ttw/Zotero/storage/4QQXM5VT/Reimann et al. - 2024 - QTFlow Quantitative Timing-Sensitive Information Flow for Security-Aware Hardware Design on RTL.pdf:application/pdf},
