  abstract = {Synthesis techniques take realizable Linear Temporal Logic specifications and produce correct cir- cuits that implement the specifications. The generated circuits can be used directly, or as miters that check the correctness of a logic design. Typically, those techniques generate non-deterministic finite state automata, which can be determinized at a possibly exponential cost. Recent results show multiple advantages of using deterministic automata in symbolic and bounded model checking of {LTL} safety properties. In this paper, we present a technique with a supporting tool that takes a sequential extended regular expression specification \{{\textbackslash}Phi\}, and a logic design implementation S, and generates a sequential circuit C, expressed as an And-Inverted-Graph, that checks whether S satisfies \{{\textbackslash}Phi\}. The technique passes the generated circuit C to {ABC}, a bounded model checker, to validate correctness. We use free input variables to encode the non- determinism in \{{\textbackslash}Phi\} and we obtain a number of states in miter linear in the size of \{{\textbackslash}Phi\}. Our technique succeeds to generate the input to the model checker while other techniques fail because of the exponential blowup, and in most cases, {ABC} succeeds to either find defects in the design that was otherwise uncheckable, or validate the design. We evaluated our technique against several industrial benchmarks including the {IBM} arbiter, a load balancer, and a traffic light system, and compared our results with the {NuSMV} framework. Our method found defects and validated systems {NuSMV} could not validate.},
  number = {{arXiv}:1401.3173},
  publisher = {{arXiv}},
  author = {Noureddine, Mohamad and Zaraket, Fadi A. and Elzein, Ali S.},
  urldate = {2025-02-13},
  date = {2014-01-14},
  eprinttype = {arxiv},
  eprint = {1401.3173 [cs]},
  keywords = {Computer Science - Formal Languages and Automata Theory, Computer Science - Logic in Computer Science},
  file = {Preprint PDF:/home/ttw/Zotero/storage/SSD3XS6R/Noureddine et al. - 2014 - Synthesis of Sequential Extended Regular Expressions for Verification.pdf:application/pdf;Snapshot:/home/ttw/Zotero/storage/BRY9XRZ5/1401.html:text/html},
}

